{
	"name": "atom-clicker-ssr",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"benchmark": "vite dev --open /benchmark",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:status": "supabase status",
		"db:reset": "supabase db reset",
		"db:diff": "supabase db diff",
		"db:push": "supabase db push",
		"db:types": "supabase gen types typescript --local > src/lib/types/supabase.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "7.2.9",
		"@sveltejs/kit": "2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "4.3.3",
		"supabase": "^2.110.0",
		"svelte": "^5.56.8",
		"svelte-check": "4.7.4",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.1.5",
		"wrangler": "^4.115.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.27.0",
		"@supabase/supabase-js": "2.110.9",
		"@types/node": "^26.1.2",
		"@xyflow/svelte": "1.6.2",
		"marked": "18.0.7",
		"virtua": "^0.50.0"
	},
	"packageManager": "bun@1.3.14",
	"trustedDependencies": [
		"esbuild",
		"svelte-preprocess",
		"workerd"
	],
	"type": "module"
}
